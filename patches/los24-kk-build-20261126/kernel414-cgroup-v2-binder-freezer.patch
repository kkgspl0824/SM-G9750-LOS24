+static void binder_thaw_proc(struct binder_proc *proc)
+{
+	binder_inner_proc_lock(proc);
+	proc->sync_recv = false;
+	proc->async_recv = false;
+	proc->is_frozen = false;
+	binder_inner_proc_unlock(proc);
+}
+
+static int binder_freeze_proc(struct binder_proc *proc, u32 timeout_ms,
+			      bool *newly_frozen)
+{
+	int ret = 0;
+
+	binder_inner_proc_lock(proc);
+	if (proc->is_frozen) {
+		binder_inner_proc_unlock(proc);
+		return 0;
+	}
+
+	proc->sync_recv = false;
+	proc->async_recv = false;
+	proc->is_frozen = true;
+	binder_inner_proc_unlock(proc);
+
+	if (timeout_ms > 0)
+		ret = wait_event_interruptible_timeout(
+			proc->freeze_wait, !READ_ONCE(proc->outstanding_txns),
+			msecs_to_jiffies(timeout_ms));
+
+	/* A thread may still be waiting for a reply. */
+	if (ret >= 0) {
+		binder_inner_proc_lock(proc);
+		ret = binder_txns_pending_ilocked(proc) ? -EAGAIN : 0;
+		binder_inner_proc_unlock(proc);
+	}
+
+	if (ret < 0)
+		binder_thaw_proc(proc);
+	else
+		*newly_frozen = true;
+
+	return ret;
+}
+
+static int binder_ioctl_freeze(const struct binder_freeze_info *info)
+{
+	struct binder_freeze_target {
+		struct binder_proc *proc;
+		bool newly_frozen;
+	} *targets;
+	struct binder_proc *proc;
+	int count = 0, i = 0, ret = 0;
+
+	mutex_lock(&binder_freeze_lock);
+	mutex_lock(&binder_procs_lock);
+	hlist_for_each_entry(proc, &binder_procs, proc_node) {
+		if (proc->pid == info->pid)
+			count++;
+	}
+
+	if (!count) {
+		ret = -EINVAL;
+		goto unlock_procs;
+	}
+
+	targets = kcalloc(count, sizeof(*targets), GFP_KERNEL);
+	if (!targets) {
+		ret = -ENOMEM;
+		goto unlock_procs;
+	}
+
+	hlist_for_each_entry(proc, &binder_procs, proc_node) {
+		if (proc->pid != info->pid)
+			continue;
+
+		binder_inner_proc_lock(proc);
+		atomic_inc(&proc->tmp_ref);
+		binder_inner_proc_unlock(proc);
+		targets[i++].proc = proc;
+	}
+	mutex_unlock(&binder_procs_lock);
+
+	for (i = 0; i < count; i++) {
+		if (!info->enable) {
+			binder_thaw_proc(targets[i].proc);
+			continue;
+		}
+
+		ret = binder_freeze_proc(targets[i].proc, info->timeout_ms,
+					 &targets[i].newly_frozen);
+		if (ret)
+			break;
+	}
+
+	/* Keep every target alive until any partial freeze has been rolled back. */
+	while (ret && i > 0) {
+		i--;
+		if (targets[i].newly_frozen)
+			binder_thaw_proc(targets[i].proc);
+	}
+
+	for (i = 0; i < count; i++)
+		binder_proc_dec_tmpref(targets[i].proc);
+	kfree(targets);
+	mutex_unlock(&binder_freeze_lock);
+	return ret;
+
+unlock_procs:
+	mutex_unlock(&binder_procs_lock);
+	mutex_unlock(&binder_freeze_lock);
+	return ret;
+}
+
+static int binder_ioctl_get_freezer_info(
+				struct binder_frozen_status_info *info)
+{
+	struct binder_proc *target_proc;
+	bool found = false;
+	__u32 txns_pending;
+
+	info->sync_recv = 0;
+	info->async_recv = 0;
+
+	mutex_lock(&binder_procs_lock);
+	hlist_for_each_entry(target_proc, &binder_procs, proc_node) {
+		if (target_proc->pid == info->pid) {
+			found = true;
+			binder_inner_proc_lock(target_proc);
+			txns_pending = binder_txns_pending_ilocked(target_proc);
+			info->sync_recv |= target_proc->sync_recv |
+					(txns_pending << 1);
+			info->async_recv |= target_proc->async_recv;
+			binder_inner_proc_unlock(target_proc);
+		}
+	}
+	mutex_unlock(&binder_procs_lock);
+
+	if (!found)
+		return -EINVAL;
+
+	return 0;
+}
