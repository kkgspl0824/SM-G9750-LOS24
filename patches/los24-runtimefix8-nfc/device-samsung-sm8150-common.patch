+/vendor/bin/hw/android\.hardware\.usb@1\.3\-service\.coral u:object_r:hal_usb_default_exec:s0
+/vendor/bin/argosd u:object_r:argosd_exec:s0
+/vendor/bin/hw/vendor\.samsung\.hardware\.thermal@1\.0\-service u:object_r:hal_thermal_default_exec:s0
+/vendor/bin/vendor\.samsung\.hardware\.security\.vaultkeeper@2\.0\-service u:object_r:vaultkeeperd_exec:s0
+/vendor/bin/hw/nxp\.android\.hardware\.nfc@1\.1\-service u:object_r:hal_nfc_default_exec:s0
+/vendor/bin/hw/vendor\.samsung\.hardware\.miscpower@2\.0\-service u:object_r:hal_power_default_exec:s0
+/vendor/bin/hw/samsung\.software\.media\.c2@1\.0\-service u:object_r:mediacodec_exec:s0
+/vendor/bin/hw/android\.hardware\.health@2\.1\-service\-samsung u:object_r:hal_health_default_exec:s0
+/vendor/bin/hw/vendor\.samsung\.hardware\.camera\.provider@4\.0\-service u:object_r:hal_camera_default_exec:s0
+/vendor/bin/hw/android\.hardware\.dumpstate@1\.1\-service\-lazy u:object_r:hal_dumpstate_default_exec:s0
+
+# Original Samsung touch IO and calibration state labels.
+/vendor/bin/hw/vendor\.samsung\.hardware\.sysinput@1\.2-service u:object_r:hal_sec_inputdev_default_exec:s0
