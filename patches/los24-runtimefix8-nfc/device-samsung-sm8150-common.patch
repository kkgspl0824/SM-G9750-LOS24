+def OTA_InstallEnd(info, input_zip):
+  AddImage(info, input_zip, "dtbo.img", "/dev/block/bootdevice/by-name/dtbo")
+  AddImage(info, input_zip, "vbmeta.img", "/dev/block/bootdevice/by-name/vbmeta")
+  AddImage(info, input_zip, "recovery.img", "/dev/block/bootdevice/by-name/recovery")
+def ImageMatches(data, dest):
+  if not data or len(data) % 4096:
+    raise ValueError("Raw partition image must be 4096-byte aligned")
+  return 'range_sha1("%s", "2,0,%d") == "%s"' % (dest, len(data) // 4096, hashlib.sha1(data).hexdigest())
+
+def AddVbmetaAssertion(info, input_zip):
+  match = VbmetaMatches(input_zip)
+  info.script.AppendExtra('assert(%s || abort("ERROR: This package requires its matching vbmeta or the explicitly approved SM-G9750 debug vbmeta."));' % match)
+
+def VbmetaMatches(input_zip):
+  data = input_zip.read("IMAGES/vbmeta.img")
+  dest = "/dev/block/bootdevice/by-name/vbmeta"
+  match = ImageMatches(data, dest)
+  baseline_path = "OTA/smg9750-approved-debug-vbmeta.img"
+  names = set(input_zip.namelist())
+  approved_profile = (len(data) == 4096 and data[:4] == b"AVB0" and
+      int.from_bytes(data[120:124], "big") == 3 and
+      "SYSTEM/build.prop" in names and "RECOVERY/RAMDISK/prop.default" in names and
+      re.search(r"^ro.build.type=userdebug$", input_zip.read("SYSTEM/build.prop").decode(), re.M) and
+      re.search(r"^ro.product.vendor.device=beyond2qlte$", input_zip.read("RECOVERY/RAMDISK/prop.default").decode(), re.M))
+  if baseline_path in names:
+    baseline = input_zip.read(baseline_path)
+    if (not approved_profile or len(baseline) != 4096 or
+        hashlib.sha256(baseline).hexdigest() != "83438dff4b72eaeaf6f773e1695c4d1f4abaedd79a0ac47f38d9bb048fbd6313"):
+      raise ValueError("Debug VBMETA reuse requires the approved flags=3 SM-G9750 userdebug profile")
+  elif not approved_profile:
+    return match
+
+  # Native target-files need no unused image payload to retain this exact approved baseline.
+  approved_match = 'range_sha1("%s", "2,0,1") == "1397b2d33cb3e75a80efc1dd7885b90425477359"' % dest
+  unlocked = '(getprop("ro.boot.vbmeta.device_state") == "unlocked" || getprop("ro.boot.verifiedbootstate") == "orange")'
+  return '(%s && (%s || %s))' % (unlocked, match, approved_match)
