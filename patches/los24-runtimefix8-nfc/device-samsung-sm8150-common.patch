diff --git a/sepolicy/vendor/genfs_contexts b/sepolicy/vendor/genfs_contexts
new file mode 100644
index 0000000..fe748b7
--- /dev/null
+++ b/sepolicy/vendor/genfs_contexts
@@ -0,0 +1,26 @@
+
+
+genfscon sysfs /module/rmnet_shs/parameters u:object_r:vendor_sysfs_rmnet:s0
+
+# SM-G9750 BCM4375 power and bluesleep controls; no generic proc/sysfs writes.
+genfscon sysfs /devices/platform/soc/soc:bt_driver/rfkill/rfkill0/state u:object_r:sysfs_bluetooth_writable:s0
+genfscon proc /bluetooth/sleep/lpm u:object_r:proc_bluetooth_writable:s0
+genfscon proc /bluetooth/sleep/btwrite u:object_r:proc_bluetooth_writable:s0
+
+# Actual HXE1 MAX77705 path and read-only moisture indication.
+genfscon sysfs /devices/platform/soc/890000.i2c/i2c-0/0-0066/max77705-usbc/typec u:object_r:beyondq_usb_typec:s0
+genfscon sysfs /devices/virtual/sec/ccic/water u:object_r:beyondq_usb_contaminant:s0
+
+# Exact moduleinfo paths requested by the HXE1 camera HAL.
+genfscon sysfs /devices/virtual/camera/rear/rear_moduleinfo u:object_r:beyondq_camera_moduleinfo:s0
+genfscon sysfs /devices/virtual/camera/rear/rear2_moduleinfo u:object_r:beyondq_camera_moduleinfo:s0
+genfscon sysfs /devices/virtual/camera/rear/rear3_moduleinfo u:object_r:beyondq_camera_moduleinfo:s0
+genfscon sysfs /devices/virtual/camera/rear/rear4_moduleinfo u:object_r:beyondq_camera_moduleinfo:s0
+genfscon sysfs /devices/virtual/camera/front/front_moduleinfo u:object_r:beyondq_camera_moduleinfo:s0
+genfscon sysfs /devices/virtual/camera/front/front2_moduleinfo u:object_r:beyondq_camera_moduleinfo:s0
+genfscon sysfs /devices/virtual/camera/front/front3_moduleinfo u:object_r:beyondq_camera_moduleinfo:s0
+
+# Exact HXE1 thermistor readings.
+genfscon sysfs /devices/virtual/sec/sec-ap-thermistor/temperature u:object_r:beyondq_thermistor:s0
+genfscon sysfs /devices/virtual/sec/sec-pa-thermistor/temperature u:object_r:beyondq_thermistor:s0
+genfscon sysfs /devices/virtual/sec/sec-wf-thermistor/temperature u:object_r:beyondq_thermistor:s0
