+allow hal_power vendor_latency_device:chr_file rw_file_perms;
+allow hal_power vendor_sysfs_kgsl:file rw_file_perms;
+allow hal_power vendor_sysfs_devfreq:file rw_file_perms;
+
+# Stock health HAL must enumerate the existing battery sysfs labels.
+r_dir_file(hal_health_default, beyondq_battery_sysfs)
+
+allow hal_usb vendor_sysfs_battery_supply:dir r_dir_perms;
+allow hal_usb vendor_sysfs_battery_supply:file rw_file_perms;
+allow vendor_thermal-engine sysfs_battery:dir search;
+
+get_prop(hal_camera, exported_camera_prop)
+get_prop(vendor_hal_perf, exported_camera_prop)
+
+# Keep HXE1 MAX77705 access scoped to its own Type-C subtree.
+type beyondq_usb_typec, fs_type, sysfs_type;
+r_dir_file(hal_usb_default, beyondq_usb_typec)
+allow hal_usb_default beyondq_usb_typec:file rw_file_perms;
+type beyondq_usb_contaminant, fs_type, sysfs_type;
+allow hal_usb_default beyondq_usb_contaminant:file r_file_perms;
+
+# Preserve the stock thermal HAL's read-only battery sensor access.
+r_dir_file(hal_thermal_default, beyondq_battery_sysfs)
+
+# Stock thermal init forwards sys.boot_completed into its vendor namespace.
+set_prop(vendor_init, vendor_thermal_prop)
+
+# HXE1 QBT2000 access for the Samsung fingerprint bridge.
+allow hal_fingerprint_default vendor_qbt_device:chr_file rw_file_perms;
+
+# HXE1 QSEE calls are required after the QBT2000 node opens.
+allow hal_fingerprint_default tee_device:chr_file rw_file_perms;
+allow hal_fingerprint_default efs_file:dir { getattr search };
+type beyondq_fingerprint_calibration, file_type;
+r_dir_file(hal_fingerprint_default, beyondq_fingerprint_calibration)
+
+# Read the Samsung module identifiers without exposing generic sysfs files.
+type beyondq_camera_moduleinfo, fs_type, sysfs_type;
+allow hal_camera_default beyondq_camera_moduleinfo:file r_file_perms;
+
+# HXE1 thermal sensors and CPU-limit monitoring remain read-only.
+type beyondq_thermistor, fs_type, sysfs_type;
+allow hal_thermal_default beyondq_thermistor:file r_file_perms;
+allow hal_thermal_default sysfs_power_writable:file r_file_perms;
+allow hal_usb_default sysfs_battery:dir search;
