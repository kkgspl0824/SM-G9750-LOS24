 ];
@@ -788,4 +791,26 @@ mod tests {
         assert_eq!(parse_release("6"), (6, 0, 0));
         assert_eq!(parse_release("android14"), (0, 0, 0));
     }
+
+    #[test]
+    fn verify_ringbuf_kernel_gates() {
+        let desc = FILE_ARR.iter().find(|f| f.filename.ends_with("/bpfRingbufProg.bpf")).unwrap();
+        assert!(desc.critical && desc.skip_on_user && !desc.allow_missing);
+        assert_eq!(desc.maps.len(), 1);
+        assert_eq!(desc.progs.len(), 1);
+        for (version, map_enabled, prog_enabled) in [
+            (kver(4, 14, 190), false, false),
+            (kver(5, 4, 186), false, false),
+            (kver(5, 7, 255), false, false),
+            (kver(5, 8, 0), true, false),
+            (kver(5, 9, 255), true, false),
+            (kver(5, 10, 0), true, true),
+            (kver(6, 1, 0), true, true),
+        ] {
+            let map = &desc.maps[0];
+            let prog = &desc.progs[0];
+            assert_eq!(version >= map.min_kver && version < map.max_kver, map_enabled);
+            assert_eq!(version >= prog.min_kver && version < prog.max_kver, prog_enabled);
+        }
+    }
 }
