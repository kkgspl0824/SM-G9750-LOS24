+static void btf(void) {
+    struct integer {struct btf_type type; uint32_t encoding;};
+    _Static_assert(sizeof(struct integer)==16 && sizeof(struct btf_header)==24,"BTF record layout");
+    struct {struct btf_header header; struct integer types[2]; char strings[9];} blob={0};
+    blob.header=(struct btf_header){.magic=BTF_MAGIC,.version=BTF_VERSION,.hdr_len=sizeof(struct btf_header),
+        .type_len=sizeof(blob.types),.str_off=sizeof(blob.types),.str_len=sizeof(blob.strings)};
+    blob.types[0]=(struct integer){.type={.name_off=1,.info=BTF_KIND_INT<<24,.size=4},.encoding=32};
+    blob.types[1]=(struct integer){.type={.name_off=5,.info=BTF_KIND_INT<<24,.size=8},.encoding=64};
+    memcpy(blob.strings,"\0u32\0u64\0",9);
+    union bpf_attr attr={.btf=PTR(&blob),.btf_size=sizeof(blob.header)+sizeof(blob.types)+sizeof(blob.strings)};
+    int fd=bpf_call(BPF_BTF_LOAD,&attr); require(fd>=0,"valid BTF load");
+    memset(&attr,0,sizeof(attr)); attr.map_type=BPF_MAP_TYPE_ARRAY;
+    attr.key_size=4; attr.value_size=8; attr.max_entries=1;
+    attr.btf_fd=fd; attr.btf_key_type_id=1; attr.btf_value_type_id=2;
+    int map=bpf_call(BPF_MAP_CREATE,&attr); require(map>=0,"BTF typed map"); close(map); close(fd);
+    ok("BTF validation and typed map ABI");
+}
+static void isolated_cgroup(void) {
+    require(unshare(CLONE_NEWNS|CLONE_NEWNET)==0,"private mount and network namespaces");
+    require(mount(NULL,"/",NULL,MS_REC|MS_PRIVATE,NULL)==0,"private mounts");
+    require(mkdtemp(mount_path)!=NULL,"temporary mount directory");
+    directory_created=1;
+    require(mount("none",mount_path,"cgroup2",0,NULL)==0,"cgroup2 mount");
+    mounted=1;
+    snprintf(child_path,sizeof(child_path),"%s/smg9750-bpf-%d",mount_path,getpid());
+    require(mkdir(child_path,0700)==0,"private test cgroup");
+    cgroup_fd=open(child_path,O_DIRECTORY|O_RDONLY|O_CLOEXEC); require(cgroup_fd>=0,"open cgroup");
+    require(write_pid(child_path)==0,"join test cgroup");
+    int ipv6=open("/proc/sys/net/ipv6/conf/lo/disable_ipv6",O_WRONLY|O_CLOEXEC);
+    require(ipv6>=0 && write(ipv6,"0",1)==1,"enable IPv6 on private loopback"); close(ipv6);
+    int fd=socket(AF_INET,SOCK_DGRAM|SOCK_CLOEXEC,0); require(fd>=0,"loopback control socket");
+    struct ifreq ifr={0}; strcpy(ifr.ifr_name,"lo");
+    require(ioctl(fd,SIOCGIFFLAGS,&ifr)==0,"loopback flags"); ifr.ifr_flags|=IFF_UP;
+    require(ioctl(fd,SIOCSIFFLAGS,&ifr)==0,"private loopback up"); close(fd);
+}
+static void deny_hook(enum bpf_prog_type type,enum bpf_attach_type hook,int family,int operation,const char *name) {
+    int fd=socket(family,SOCK_DGRAM|SOCK_CLOEXEC,0); require(fd>=0,"socket before attach");
+    attach(return_program(type,hook,0),hook);
+    struct sockaddr_storage address={0}; socklen_t length;
+    if(family==AF_INET) {struct sockaddr_in *a=(void *)&address;a->sin_family=AF_INET;a->sin_addr.s_addr=htonl(INADDR_LOOPBACK);a->sin_port=htons(operation==1 ? 9 : 0);length=sizeof(*a);}
+    else {struct sockaddr_in6 *a=(void *)&address;a->sin6_family=AF_INET6;a->sin6_addr=in6addr_loopback;a->sin6_port=htons(operation==1 ? 9 : 0);length=sizeof(*a);}
+    int value=0,result; socklen_t size=sizeof(value); errno=0;
+    if(operation==0) result=bind(fd,(void *)&address,length);
+    else if(operation==1) result=connect(fd,(void *)&address,length);
+    else if(operation==2) result=setsockopt(fd,IPPROTO_IP,IP_TOS,&value,sizeof(value));
+    else result=getsockopt(fd,IPPROTO_IP,IP_TOS,&value,&size);
+    require(result<0 && errno==EPERM,name); detach(); size=sizeof(value);
+    if(operation==0) result=bind(fd,(void *)&address,length);
+    else if(operation==1) result=connect(fd,(void *)&address,length);
+    else if(operation==2) result=setsockopt(fd,IPPROTO_IP,IP_TOS,&value,sizeof(value));
+    else result=getsockopt(fd,IPPROTO_IP,IP_TOS,&value,&size);
+    require(result==0,"operation allowed after detach"); close(fd); ok(name);
+}
+static void counter_hook(enum bpf_prog_type type,enum bpf_attach_type hook,int family,const char *name) {
+    int map=map_create(BPF_MAP_TYPE_ARRAY,4,8,1,0); require(map>=0,"counter map");
+    struct bpf_insn code[]={I(BPF_ST|BPF_MEM|BPF_W,10,0,-4,0),
+        I(BPF_LD|BPF_DW|BPF_IMM,1,BPF_PSEUDO_MAP_FD,0,map), I(0,0,0,0,0),
+        I(BPF_ALU64|BPF_MOV|BPF_X,2,10,0,0),I(BPF_ALU64|BPF_ADD|BPF_K,2,0,0,-4),
+        I(BPF_JMP|BPF_CALL,0,0,0,BPF_FUNC_map_lookup_elem),I(BPF_JMP|BPF_JEQ|BPF_K,0,0,3,0),
+        I(BPF_LDX|BPF_MEM|BPF_DW,1,0,0,0),I(BPF_ALU64|BPF_ADD|BPF_K,1,0,0,1),
+        I(BPF_STX|BPF_MEM|BPF_DW,0,1,0,0),I(BPF_ALU64|BPF_MOV|BPF_K,0,0,0,1),I(BPF_JMP|BPF_EXIT,0,0,0,0)};
+    attach(load(type,hook,code,sizeof(code)/sizeof(code[0])),hook);
+    int rx=socket(family,SOCK_DGRAM|SOCK_CLOEXEC,0), tx=socket(family,SOCK_DGRAM|SOCK_CLOEXEC,0);
+    require(rx>=0 && tx>=0,"UDP loopback sockets");
+    struct timeval timeout={.tv_sec=2}; require(setsockopt(rx,SOL_SOCKET,SO_RCVTIMEO,&timeout,sizeof(timeout))==0,"receive timeout");
+    struct sockaddr_storage address={0}; socklen_t size;
+    if(family==AF_INET) {struct sockaddr_in *a=(void *)&address;a->sin_family=AF_INET;a->sin_addr.s_addr=htonl(INADDR_LOOPBACK);size=sizeof(*a);}
+    else {struct sockaddr_in6 *a=(void *)&address;a->sin6_family=AF_INET6;a->sin6_addr=in6addr_loopback;size=sizeof(*a);}
+    require(bind(rx,(void *)&address,size)==0,"UDP bind");
+    require(getsockname(rx,(void *)&address,&size)==0,"UDP address");
+    require(sendto(tx,"x",1,0,(void *)&address,size)==1,"UDP send");
+    char byte=0; struct sockaddr_storage from; size=sizeof(from);
+    require(recvfrom(rx,&byte,1,0,(void *)&from,&size)==1 && byte=='x',"UDP receive");
+    uint64_t count=0; require(map_value(map,0,&count)==0 && count>0,name);
+    close(tx); close(rx); detach(); close(map); ok(name);
+}
+int main(void) {
+    setbuf(stdout,NULL); require(geteuid()==0,"root required"); atexit(cleanup);
+    struct utsname version; require(uname(&version)==0,"real uname"); printf("REAL_KERNEL %s\n",version.release);
+    struct rlimit limit={RLIM_INFINITY,RLIM_INFINITY}; require(setrlimit(RLIMIT_MEMLOCK,&limit)==0,"BPF memlock limit");
+    maps_and_verifier(); btf(); isolated_cgroup();
+    attach(return_program(BPF_PROG_TYPE_CGROUP_SOCK,BPF_CGROUP_INET_SOCK_CREATE,0),BPF_CGROUP_INET_SOCK_CREATE);
+    errno=0; int denied=socket(AF_INET,SOCK_DGRAM|SOCK_CLOEXEC,0);
+    require(denied<0 && errno==EPERM,"socket create hook executes"); detach(); ok("socket create deny hook");
+    deny_hook(BPF_PROG_TYPE_CGROUP_SOCK_ADDR,BPF_CGROUP_INET4_BIND,AF_INET,0,"IPv4 bind hook");
+    deny_hook(BPF_PROG_TYPE_CGROUP_SOCK_ADDR,BPF_CGROUP_INET6_BIND,AF_INET6,0,"IPv6 bind hook");
+    deny_hook(BPF_PROG_TYPE_CGROUP_SOCK_ADDR,BPF_CGROUP_INET4_CONNECT,AF_INET,1,"IPv4 connect hook");
+    deny_hook(BPF_PROG_TYPE_CGROUP_SOCK_ADDR,BPF_CGROUP_INET6_CONNECT,AF_INET6,1,"IPv6 connect hook");
+    deny_hook(BPF_PROG_TYPE_CGROUP_SOCKOPT,BPF_CGROUP_SETSOCKOPT,AF_INET,2,"setsockopt hook");
+    deny_hook(BPF_PROG_TYPE_CGROUP_SOCKOPT,BPF_CGROUP_GETSOCKOPT,AF_INET,3,"getsockopt hook");
+    counter_hook(BPF_PROG_TYPE_CGROUP_SKB,BPF_CGROUP_INET_EGRESS,AF_INET,"IPv4 egress hook executes on packets");
+    counter_hook(BPF_PROG_TYPE_CGROUP_SKB,BPF_CGROUP_INET_INGRESS,AF_INET,"IPv4 ingress hook executes on packets");
+    counter_hook(BPF_PROG_TYPE_CGROUP_SKB,BPF_CGROUP_INET_EGRESS,AF_INET6,"IPv6 egress hook executes on packets");
+    counter_hook(BPF_PROG_TYPE_CGROUP_SKB,BPF_CGROUP_INET_INGRESS,AF_INET6,"IPv6 ingress hook executes on packets");
+    counter_hook(BPF_PROG_TYPE_CGROUP_SOCK_ADDR,BPF_CGROUP_UDP4_SENDMSG,AF_INET,"UDP4 sendmsg hook executes");
+    counter_hook(BPF_PROG_TYPE_CGROUP_SOCK_ADDR,BPF_CGROUP_UDP4_RECVMSG,AF_INET,"UDP4 recvmsg hook executes");
+    counter_hook(BPF_PROG_TYPE_CGROUP_SOCK_ADDR,BPF_CGROUP_UDP6_SENDMSG,AF_INET6,"UDP6 sendmsg hook executes");
+    counter_hook(BPF_PROG_TYPE_CGROUP_SOCK_ADDR,BPF_CGROUP_UDP6_RECVMSG,AF_INET6,"UDP6 recvmsg hook executes");
+    cleanup(); require(!cleanup_failed,"temporary cgroup and mount cleanup");
+    printf("BPF54_RUNTIME_PROBE_COMPLETE passed=%u\n",passed); return 0;
+}
