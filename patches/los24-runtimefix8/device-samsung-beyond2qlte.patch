+// Keep the Android 16 C++ runtime out of the legacy vendor library namespace.
+cc_binary {
+    name: "android.hardware.biometrics.fingerprint-service.samsung.beyond2qlte",
+    relative_install_path: "hw",
+    srcs: ["//hardware/samsung:samsung_fingerprint_aidl_sources"],
+    init_rc: ["android.hardware.biometrics.fingerprint-service.samsung.beyond2qlte.rc"],
+    vintf_fragments: ["android.hardware.biometrics.fingerprint-service.samsung.beyond2qlte.xml"],
+    header_libs: ["libhardware_headers"],
+    include_dirs: ["hardware/interfaces/biometrics/common/util/include"],
+    static_libs: [
+        "libbase",
+        "android.hardware.biometrics.fingerprint-V4-ndk",
+        "android.hardware.biometrics.common-V4-ndk",
+        "android.hardware.keymaster-V4-ndk",
+        "libandroid.hardware.biometrics.fingerprint.SamsungProps",
+    ],
+    shared_libs: ["libbinder_ndk", "liblog"],
+    stl: "c++_static",
+    ldflags: ["-Wl,--exclude-libs,ALL"],
+    vendor: true,
+}
