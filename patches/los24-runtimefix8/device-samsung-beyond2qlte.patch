diff --git a/aidl/power/service.cpp b/aidl/power/service.cpp
new file mode 100644
index 0000000..d736443
--- /dev/null
+++ b/aidl/power/service.cpp
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "Power.h"
+#include <android/binder_manager.h>
+#include <android/binder_process.h>
+
+using namespace aidl::android::hardware::power;
+
+int main() {
+    ::android::base::SetDefaultTag("beyond2qlte-power");
+    ABinderProcess_setThreadPoolMaxThreadCount(0);
+    const std::string legacy = std::string(IPower::descriptor) + "/legacy0";
+    auto backend = IPower::fromBinder(ndk::SpAIBinder(AServiceManager_waitForService(legacy.c_str())));
+    CHECK(backend != nullptr);
+    auto power = ndk::SharedRefBase::make<BeyondPower>(backend, "/sys/class/sec/tsp/cmd",
+                                                       "/sys/class/sec/tsp/input/enabled");
+    const std::string instance = std::string(IPower::descriptor) + "/default";
+    CHECK(AServiceManager_addService(power->asBinder().get(), instance.c_str()) == STATUS_OK);
+    ABinderProcess_joinThreadPool();
+    return EXIT_FAILURE;
+}
diff --git a/aidl/power/tests.cpp b/aidl/power/tests.cpp
new file mode 100644
index 0000000..1f4acab
--- /dev/null
+++ b/aidl/power/tests.cpp
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "Power.h"
+#include "Legacy2Aidl.h"
+#include <gtest/gtest.h>
+#include <android-base/test_utils.h>
+#include <cstring>
+
+using namespace aidl::android::hardware::power;
+namespace fp = aidl::android::hardware::biometrics::fingerprint;
+
+class Backend : public IPowerDefault {
+  public:
+    int calls = 0;
+    Mode mode = Mode::DOUBLE_TAP_TO_WAKE;
+    Boost boost = Boost::INTERACTION;
+    bool enabled = false;
+    int32_t duration = 0;
+    ndk::ScopedAStatus setMode(Mode m, bool e) override {
+        ++calls; mode = m; enabled = e;
+        return ndk::ScopedAStatus::fromExceptionCode(EX_UNSUPPORTED_OPERATION);
+    }
+    ndk::ScopedAStatus isModeSupported(Mode m, bool* out) override {
+        ++calls; mode = m; *out = m == Mode::LAUNCH;
+        return ndk::ScopedAStatus::ok();
+    }
+    ndk::ScopedAStatus setBoost(Boost b, int32_t d) override {
+        ++calls; boost = b; duration = d;
+        return ndk::ScopedAStatus::fromExceptionCode(EX_UNSUPPORTED_OPERATION);
+    }
+    ndk::ScopedAStatus isBoostSupported(Boost b, bool* out) override {
+        ++calls; boost = b; *out = b == Boost::INTERACTION;
+        return ndk::ScopedAStatus::ok();
+    }
+};
+
+TEST(Power, DoubleTapChangesOnlyTheGestureCommand) {
+    TemporaryFile file;
+    auto backend = ndk::SharedRefBase::make<Backend>();
+    auto power = ndk::SharedRefBase::make<BeyondPower>(backend, file.path, "/does-not-exist/smg9750-tsp-enabled");
+    bool supported = false;
+    ASSERT_TRUE(power->isModeSupported(Mode::DOUBLE_TAP_TO_WAKE, &supported).isOk());
+    EXPECT_TRUE(supported);
+    for (bool enabled : {true, false, true}) {
+        ASSERT_TRUE(power->setMode(Mode::DOUBLE_TAP_TO_WAKE, enabled).isOk());
+        std::string command;
+        ASSERT_TRUE(android::base::ReadFileToString(file.path, &command));
+        EXPECT_EQ(command, enabled ? "aot_enable,1" : "aot_enable,0");
+    }
+    EXPECT_EQ(backend->calls, 0);
+    auto missing = ndk::SharedRefBase::make<BeyondPower>(backend, "/does-not-exist/smg9750-tsp-command", "/does-not-exist/smg9750-tsp-enabled");
+    EXPECT_FALSE(missing->setMode(Mode::DOUBLE_TAP_TO_WAKE, true).isOk());
+}
+
+TEST(Power, InteractiveTransitionsPreserveTheGestureMask) {
+    TemporaryFile gesture;
+    TemporaryFile input;
+    auto backend = ndk::SharedRefBase::make<Backend>();
+    auto power = ndk::SharedRefBase::make<BeyondPower>(backend, gesture.path, input.path);
+    bool supported = false;
+    ASSERT_TRUE(power->isModeSupported(Mode::INTERACTIVE, &supported).isOk());
+    EXPECT_TRUE(supported);
+    for (bool doubleTap : {false, true}) {
+        ASSERT_TRUE(power->setMode(Mode::DOUBLE_TAP_TO_WAKE, doubleTap).isOk());
+        for (bool interactive : {false, true, false, true}) {
+            ASSERT_TRUE(power->setMode(Mode::INTERACTIVE, interactive).isOk());
+            std::string enabled, command;
+            ASSERT_TRUE(android::base::ReadFileToString(input.path, &enabled));
+            ASSERT_TRUE(android::base::ReadFileToString(gesture.path, &command));
+            EXPECT_EQ(enabled, interactive ? "1" : "0");
+            EXPECT_EQ(command, doubleTap ? "aot_enable,1" : "aot_enable,0");
+        }
+    }
+    EXPECT_EQ(backend->calls, 0);
+    auto missing = ndk::SharedRefBase::make<BeyondPower>(backend, gesture.path,
+                                                       "/does-not-exist/smg9750-tsp-enabled");
+    EXPECT_EQ(missing->setMode(Mode::INTERACTIVE, false).getExceptionCode(), EX_ILLEGAL_STATE);
+    std::string command;
+    ASSERT_TRUE(android::base::ReadFileToString(gesture.path, &command));
+    EXPECT_EQ(command, "aot_enable,1");
+}
+
+TEST(Power, PreservesBackendModesBoostsAndErrors) {
+    auto backend = ndk::SharedRefBase::make<Backend>();
+    auto power = ndk::SharedRefBase::make<BeyondPower>(backend, "/does-not-exist/smg9750-tsp-command", "/does-not-exist/smg9750-tsp-enabled");
+    for (auto mode : ndk::enum_range<Mode>()) {
+        if (mode == Mode::DOUBLE_TAP_TO_WAKE || mode == Mode::INTERACTIVE) continue;
+        bool supported = false;
+        ASSERT_TRUE(power->isModeSupported(mode, &supported).isOk());
+        EXPECT_EQ(supported, mode == Mode::LAUNCH);
+        for (bool enabled : {false, true}) {
+            EXPECT_EQ(power->setMode(mode, enabled).getExceptionCode(), EX_UNSUPPORTED_OPERATION);
+            EXPECT_EQ(backend->mode, mode);
+            EXPECT_EQ(backend->enabled, enabled);
+        }
+    }
+    for (auto boost : ndk::enum_range<Boost>()) {
+        bool supported = false;
+        ASSERT_TRUE(power->isBoostSupported(boost, &supported).isOk());
+        EXPECT_EQ(supported, boost == Boost::INTERACTION);
+        for (int32_t duration : {-1, 0, 1000}) {
+            EXPECT_EQ(power->setBoost(boost, duration).getExceptionCode(), EX_UNSUPPORTED_OPERATION);
+            EXPECT_EQ(backend->boost, boost);
+            EXPECT_EQ(backend->duration, duration);
+        }
+    }
+}
+
+TEST(AuthToken, InitializesVersionAndPreservesWireFormat) {
+    HardwareAuthToken source;
+    source.challenge = 0x1122334455667788;
+    source.userId = 123;
+    source.authenticatorId = 456;
+    source.authenticatorType = aidl::android::hardware::keymaster::HardwareAuthenticatorType::PASSWORD;
+    source.timestamp.milliSeconds = 0x0102030405060708;
+    source.mac.assign(32, 0x5a);
+    hw_auth_token_t output;
+    std::memset(&output, 0xa5, sizeof(output));
+    ASSERT_TRUE(fp::translate(source, output));
+    EXPECT_EQ(sizeof(output), 69u);
+    EXPECT_EQ(output.version, HW_AUTH_TOKEN_VERSION);
+    EXPECT_EQ(output.challenge, static_cast<uint64_t>(source.challenge));
+    const auto* bytes = reinterpret_cast<const uint8_t*>(&output);
+    const uint8_t network[] = {0, 0, 0, 1, 1, 2, 3, 4, 5, 6, 7, 8};
+    EXPECT_EQ(std::memcmp(bytes + 25, network, sizeof(network)), 0);
+    EXPECT_EQ(std::memcmp(output.hmac, source.mac.data(), 32), 0);
+    HardwareAuthToken roundTrip;
+    roundTrip.mac.assign(4, 0xff);
+    fp::translate(output, roundTrip);
+    EXPECT_EQ(roundTrip, source);
+}
+
+TEST(AuthToken, RejectsMalformedMacBeforeWritingLegacyBuffer) {
+    for (size_t size : {0u, 31u, 33u, 4096u}) {
+        HardwareAuthToken source;
+        source.mac.assign(size, 0x5a);
+        struct { uint8_t before[8]; hw_auth_token_t token; uint8_t after[8]; } buffer;
+        std::memset(&buffer, 0xa5, sizeof(buffer));
+        const auto original = buffer;
+        EXPECT_FALSE(fp::translate(source, buffer.token));
+        EXPECT_EQ(std::memcmp(&original, &buffer, sizeof(buffer)), 0);
+    }
+}
