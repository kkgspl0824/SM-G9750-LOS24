diff --git a/tests/kernel414-bpf/smg9750_bpf_probe.c b/tests/kernel414-bpf/smg9750_bpf_probe.c
new file mode 100644
index 0000000..aa1d367
--- /dev/null
+++ b/tests/kernel414-bpf/smg9750_bpf_probe.c
@@ -0,0 +1,243 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/bpf.h>
+#include <linux/btf.h>
+#include <net/if.h>
+#include <sched.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mount.h>
+#include <sys/resource.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <sys/time.h>
+#include <sys/utsname.h>
+#include <unistd.h>
+
+#define PTR(p) ((uint64_t)(uintptr_t)(p))
+#define I(c,d,s,o,n) ((struct bpf_insn){.code=(c),.dst_reg=(d),.src_reg=(s),.off=(o),.imm=(n)})
+static int cgroup_fd = -1, active_program = -1;
+static enum bpf_attach_type active_type;
+static int directory_created, mounted, cleanup_failed;
+static char mount_path[] = "/tmp/smg9750-bpf-XXXXXX", child_path[160];
+static char verifier_log[65536];
+static unsigned passed;
+
+static int bpf_call(enum bpf_cmd command, union bpf_attr *attr) {
+    return syscall(__NR_bpf, command, attr, sizeof(*attr));
+}
+static void fail(const char *name) {
+    fprintf(stderr, "FAIL %s errno=%d (%s)\n", name, errno, strerror(errno));
+    exit(1);
+}
+static void require(int condition, const char *name) { if (!condition) fail(name); }
+static void ok(const char *name) { printf("PASS %s\n", name); passed++; fflush(stdout); }
+static void detach(void) {
+    if (active_program < 0) return;
+    union bpf_attr attr = {.target_fd = cgroup_fd, .attach_bpf_fd = active_program,
+                          .attach_type = active_type};
+    require(bpf_call(BPF_PROG_DETACH, &attr) == 0, "cgroup detach");
+    close(active_program); active_program = -1;
+}
+static int write_pid(const char *directory) {
+    char path[200], value[32];
+    snprintf(path, sizeof(path), "%s/cgroup.procs", directory);
+    int fd = open(path, O_WRONLY | O_CLOEXEC);
+    if (fd < 0) return -1;
+    int length = snprintf(value, sizeof(value), "%d\n", getpid());
+    int result = write(fd, value, length) == length ? 0 : -1;
+    close(fd); return result;
+}
+static void cleanup(void) {
+    if (active_program >= 0) {
+        union bpf_attr attr = {.target_fd = cgroup_fd, .attach_bpf_fd = active_program,
+                              .attach_type = active_type};
+        bpf_call(BPF_PROG_DETACH, &attr); close(active_program); active_program = -1;
+    }
+    if (cgroup_fd >= 0) {
+        if (write_pid(mount_path) < 0) cleanup_failed=1;
+        close(cgroup_fd); cgroup_fd=-1;
+        if (rmdir(child_path) < 0) cleanup_failed=1;
+    }
+    if (mounted) { if (umount(mount_path) < 0) cleanup_failed=1; else mounted=0; }
+    if (directory_created) { if (rmdir(mount_path) < 0) cleanup_failed=1; else directory_created=0; }
+}
+static int map_create(enum bpf_map_type type, uint32_t key, uint32_t value,
+                      uint32_t count, uint32_t flags) {
+    union bpf_attr attr = {.map_type=type, .key_size=key, .value_size=value,
+                          .max_entries=count, .map_flags=flags};
+    return bpf_call(BPF_MAP_CREATE, &attr);
+}
+static int map_value(int fd, int update, uint64_t *value) {
+    uint32_t key = 0;
+    union bpf_attr attr = {.map_fd=fd, .key=PTR(&key), .value=PTR(value)};
+    return bpf_call(update ? BPF_MAP_UPDATE_ELEM : BPF_MAP_LOOKUP_ELEM, &attr);
+}
+static int load(enum bpf_prog_type type, enum bpf_attach_type attach,
+                const struct bpf_insn *code, unsigned count) {
+    memset(verifier_log, 0, sizeof(verifier_log));
+    union bpf_attr attr = {.prog_type=type, .expected_attach_type=attach,
+                          .insns=PTR(code), .insn_cnt=count, .license=PTR("GPL"),
+                          .log_buf=PTR(verifier_log), .log_size=sizeof(verifier_log), .log_level=1};
+    return bpf_call(BPF_PROG_LOAD, &attr);
+}
+static int return_program(enum bpf_prog_type type, enum bpf_attach_type attach, int value) {
+    struct bpf_insn code[] = {I(BPF_ALU64|BPF_MOV|BPF_K,0,0,0,value), I(BPF_JMP|BPF_EXIT,0,0,0,0)};
+    return load(type, attach, code, sizeof(code)/sizeof(code[0]));
+}
+static void attach(int program, enum bpf_attach_type type) {
+    require(program >= 0, "load cgroup program");
+    union bpf_attr attr = {.target_fd=cgroup_fd, .attach_bpf_fd=program, .attach_type=type};
+    require(bpf_call(BPF_PROG_ATTACH, &attr) == 0, "cgroup attach");
+    active_program=program; active_type=type;
+    uint32_t ids[2] = {0};
+    memset(&attr, 0, sizeof(attr)); attr.query.target_fd=cgroup_fd;
+    attr.query.attach_type=type; attr.query.prog_cnt=2; attr.query.prog_ids=PTR(ids);
+    require(bpf_call(BPF_PROG_QUERY, &attr) == 0 && attr.query.prog_cnt == 1 && ids[0], "cgroup query");
+}
+static void maps_and_verifier(void) {
+    const enum bpf_map_type types[] = {BPF_MAP_TYPE_HASH, BPF_MAP_TYPE_ARRAY,
+        BPF_MAP_TYPE_PERCPU_ARRAY, BPF_MAP_TYPE_LRU_HASH, BPF_MAP_TYPE_DEVMAP_HASH};
+    for (unsigned n=0; n<sizeof(types)/sizeof(types[0]); n++) {
+        int fd=map_create(types[n],4,types[n]==BPF_MAP_TYPE_DEVMAP_HASH ? 4 : 8,8,0);
+        if (fd<0) fprintf(stderr,"map_type=%u\n",types[n]);
+        require(fd>=0, "required BPF map type"); close(fd);
+    }
+    ok("HASH ARRAY PERCPU_ARRAY LRU_HASH DEVMAP_HASH maps");
+    int fd=map_create(BPF_MAP_TYPE_ARRAY,4,8,1,0); require(fd>=0,"array create");
+    uint64_t value=UINT64_C(0x123456789abcdef), result=0;
+    require(map_value(fd,1,&value)==0 && map_value(fd,0,&result)==0 && result==value,"map roundtrip");
+    union bpf_attr attr={.map_fd=fd}; require(bpf_call(BPF_MAP_FREEZE,&attr)==0,"map freeze");
+    errno=0; require(map_value(fd,1,&value)<0 && errno==EPERM,"frozen map rejects update"); close(fd);
+    ok("map update lookup and enforced freeze");
+    fd=return_program(BPF_PROG_TYPE_SOCKET_FILTER,0,42); require(fd>=0,"socket filter load");
+    struct bpf_prog_info info={0}; memset(&attr,0,sizeof(attr));
+    attr.info.bpf_fd=fd; attr.info.info_len=sizeof(info); attr.info.info=PTR(&info);
+    require(bpf_call(BPF_OBJ_GET_INFO_BY_FD,&attr)==0 && info.jited_prog_len>0,"actual JIT output");
+    unsigned char packet[64]={0}; packet[12]=8; packet[14]=0x45; packet[23]=17;
+    memset(&attr,0,sizeof(attr)); attr.test.prog_fd=fd; attr.test.data_in=PTR(packet);
+    attr.test.data_size_in=sizeof(packet); attr.test.repeat=1;
+    require(bpf_call(BPF_PROG_TEST_RUN,&attr)==0 && attr.test.retval==42,"JIT program execution"); close(fd);
+    struct bpf_insn invalid[]={I(BPF_LDX|BPF_MEM|BPF_DW,0,1,32760,0),I(BPF_JMP|BPF_EXIT,0,0,0,0)};
+    fd=load(BPF_PROG_TYPE_SOCKET_FILTER,0,invalid,2);
+    require(fd<0,"verifier rejects invalid context access");
+    ok("JIT execution and invalid program rejection");
+    struct bpf_insn clock[]={I(BPF_JMP|BPF_CALL,0,0,0,BPF_FUNC_ktime_get_boot_ns),
