diff --git a/rootdir/etc/00-smg9750-legacy-metadata.rc b/rootdir/etc/00-smg9750-legacy-metadata.rc
new file mode 100644
index 0000000..ba1fb34
--- /dev/null
+++ b/rootdir/etc/00-smg9750-legacy-metadata.rc
@@ -0,0 +1,20 @@
+# Imported vendor fs actions mount cache before system init fragments run.
+# shortcut: aconfigd uses its post-fs retry; revisit if metadata is required before fs.
+on fs
+    # Zygote preloads flag readers as UID/GID 9999; permit traversal to public maps.
+    mkdir /cache/legacy_metadata 0771 root system
+    mount none /cache/legacy_metadata /metadata bind
+    restorecon_recursive /metadata
+
+# Keep the boot timer independent of zygote restarts.
+on boot && property:ro.build.type=userdebug
+    start smg9750_boot_watchdog
+
+service smg9750_boot_watchdog /system/bin/sh /system/etc/smg9750-boot-watchdog.sh
+    class core
+    user shell
+    group shell
+    seclabel u:r:shell:s0
+    setenv PATH /system/bin
+    disabled
+    oneshot
