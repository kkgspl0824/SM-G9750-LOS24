diff --git a/aidl/power/Power.h b/aidl/power/Power.h
new file mode 100644
index 0000000..8aa35f9
--- /dev/null
+++ b/aidl/power/Power.h
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <aidl/android/hardware/power/BnPower.h>
+#include <android-base/file.h>
+#include <android-base/logging.h>
+
+namespace aidl::android::hardware::power {
+
+// Keep HXE1's performance hints in its own process and C++ runtime.
+class BeyondPower : public BnPower {
+  public:
+    BeyondPower(std::shared_ptr<IPower> backend, std::string commandPath,
+                std::string enabledPath)
+        : backend_(std::move(backend)), commandPath_(std::move(commandPath)),
+          enabledPath_(std::move(enabledPath)) {}
+
+    ndk::ScopedAStatus setMode(Mode mode, bool enabled) override {
+        const bool doubleTap = mode == Mode::DOUBLE_TAP_TO_WAKE;
+        if (!doubleTap && mode != Mode::INTERACTIVE) return backend_->setMode(mode, enabled);
+        const auto& path = doubleTap ? commandPath_ : enabledPath_;
+        const char* value = enabled ? "1" : "0";
+        const std::string command = doubleTap ? std::string("aot_enable,") + value : value;
+        if (!::android::base::WriteStringToFile(command, path)) {
+            PLOG(ERROR) << "Failed to set touchscreen " << toString(mode);
+            return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_STATE);
+        }
+        LOG(INFO) << "Touchscreen " << toString(mode) << "=" << value;
+        return ndk::ScopedAStatus::ok();
+    }
+
+    ndk::ScopedAStatus isModeSupported(Mode mode, bool* supported) override {
+        if (mode != Mode::DOUBLE_TAP_TO_WAKE && mode != Mode::INTERACTIVE)
+            return backend_->isModeSupported(mode, supported);
+        *supported = true;
+        return ndk::ScopedAStatus::ok();
+    }
+
+    ndk::ScopedAStatus setBoost(Boost boost, int32_t duration) override {
+        return backend_->setBoost(boost, duration);
+    }
+
+    ndk::ScopedAStatus isBoostSupported(Boost boost, bool* supported) override {
+        return backend_->isBoostSupported(boost, supported);
+    }
+
+  private:
+    const std::shared_ptr<IPower> backend_;
+    const std::string commandPath_;
+    const std::string enabledPath_;
+};
+}  // namespace aidl::android::hardware::power
