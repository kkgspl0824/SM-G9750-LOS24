+genfscon sysfs /devices/platform/soc/soc:battery/power_supply/battery/cisd_event_data u:object_r:vendor_sysfs_battery_supply:s0
+genfscon sysfs /devices/platform/soc/soc:battery/power_supply/battery/cisd_wire_count u:object_r:vendor_sysfs_battery_supply:s0
+genfscon sysfs /devices/platform/soc/soc:battery/power_supply/battery/batt_capacity_max u:object_r:vendor_sysfs_battery_supply:s0
