diff --git a/rootdir/etc/smg9750-boot-watchdog.sh b/rootdir/etc/smg9750-boot-watchdog.sh
new file mode 100644
index 0000000..7ad614f
--- /dev/null
+++ b/rootdir/etc/smg9750-boot-watchdog.sh
@@ -0,0 +1,23 @@
+#!/system/bin/sh
+# shortcut: diagnostic boots get five minutes; remove after first boot is reliable.
+trap 'exit 0' HUP INT TERM
+recovery=$(getprop init.svc.recovery) || exit 0
+[ "$recovery" != running ] || exit 0
+
+elapsed=0
+while [ "$elapsed" -lt 300 ]; do
+    completed=$(getprop sys.boot_completed) || exit 0
+    [ "$completed" != 1 ] || exit 0
+    shutdown=$(getprop sys.powerctl) || exit 0
+    [ -z "$shutdown" ] || exit 0
+    sleep 5 || exit 0
+    elapsed=$((elapsed + 5))
+done
+
+# Recheck at the deadline so a just-completed boot is not interrupted.
+completed=$(getprop sys.boot_completed) || exit 0
+[ "$completed" != 1 ] || exit 0
+shutdown=$(getprop sys.powerctl) || exit 0
+[ -z "$shutdown" ] || exit 0
+log -p w -t SMG9750BootWatchdog "Boot incomplete after 300 seconds; rebooting to Recovery"
+setprop sys.powerctl reboot,recovery
