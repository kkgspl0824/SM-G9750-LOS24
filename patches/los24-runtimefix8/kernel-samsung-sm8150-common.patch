+static int rmnet_shs_wq_time_check(time_t time, int num_flows)
+{
+
+	int ret = false;
+
+	if (time > rmnet_shs_max_flow_inactivity_sec)
+		ret = true;
+	else if (num_flows > FLOW_LIMIT2 && time > INACTIVE_TSEC2)
+		ret = true;
+	else if (num_flows > FLOW_LIMIT1 && time > INACTIVE_TSEC1)
+		ret = true;
+
+	return ret;
+}
